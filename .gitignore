# Build
/build/
/out/
/vcpkg_installed/
/.vcpkg/
/.vcpkg-cache/
/.ndk/
CMakeUserPresets.json
compile_commands.json

# Secret keys of mc_pack_tool: they never go into the repository (ADR-06). keygen writes them
# to ~/.config/seekers-companion/keys; this is only a safety net.
*.mcsk

# Official Malediction content: it never goes into the repository (ADR-12)
/content/official/*
!/content/official/README.md

# Python bytecode (tools/content and tools/ci)
__pycache__/

# Coverage, fuzzing and analysis
*.gcda
*.gcno
*.gcov
/coverage/
crash-*
leak-*
timeout-*
oom-*

# Editors and operating system
.idea/
.vs/
.vscode/
*.swp
.DS_Store
Thumbs.db
