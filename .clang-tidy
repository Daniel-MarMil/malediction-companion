#
# Static analysis of the core. Usage: clang-tidy -p build/<preset> core/src/*.cpp
# Justified exceptions:
#  - reinterpret_cast, new[] and delete[] are needed at the C boundary (ADR-11).
#  - Magic numbers and short names are left to code review.
#  - The C++ headers use #pragma once, which GCC, Clang, MSVC and the NDK support.
#    The C header (mc_api.h) keeps a classic include guard so any compiler accepts it.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers
HeaderFilterRegex: '.*/core/(include|src)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 30
