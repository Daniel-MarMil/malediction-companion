# LF line endings in the repository, also when working from Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fuzzing seeds are inputs and stay byte for byte: some have Windows line endings.
fuzz/corpus/** -text

# Binaries
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.sig binary
